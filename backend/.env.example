# GreenRoute configuration example.
#
# Copy to `.env` if your shell or process manager loads environment files; the
# application itself reads the process environment only. Nothing here is a real
# credential, and no value below is required except in the situations noted.

# --- Core -------------------------------------------------------------------
# Signs administrator session cookies. A random value is required anywhere the
# server is reachable by someone other than the person running it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# When unset, the app falls back to a development key that is public in this
# repository and prints a warning at startup.
SECRET_KEY=replace-with-a-private-random-value

# SQLite file. Defaults to instance/greenroute.sqlite.
GREENROUTE_DB=instance/greenroute.sqlite

# Development server port used by `python app.py`.
GREENROUTE_PORT=5000

# Set to 1 when the site is served over HTTPS, so the session cookie is marked
# Secure. Leave unset for http://127.0.0.1 development.
GREENROUTE_HTTPS=0

# --- First administrator ----------------------------------------------------
# Only read when the administrators table is empty. With neither variable set,
# the account admin@greenroute.local is created with a random password written
# to instance/first-admin.txt (gitignored). Set both to choose them yourself.
GREENROUTE_BOOTSTRAP_ADMIN_EMAIL=
GREENROUTE_BOOTSTRAP_ADMIN_PASSWORD=

# --- Routing ----------------------------------------------------------------
# OSRM HTTP endpoint. The default is the public OSRM demo server, which is for
# light use only; run your own instance for anything sustained.
GREENROUTE_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# --- Geocoding and address search -------------------------------------------
GREENROUTE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GREENROUTE_PHOTON_URL=https://photon.komoot.io/api/
GREENROUTE_GEOCODING_USER_AGENT=GreenRoute/1.0 (local operations console)
# Nominatim's usage policy asks for a contact address.
GREENROUTE_GEOCODING_EMAIL=
GREENROUTE_GEOCODING_MIN_INTERVAL=1.1
GREENROUTE_GEOCODING_TIMEOUT=12
GREENROUTE_GEOCODING_CONTEXT_KM=150
GREENROUTE_SUGGESTION_CACHE_TTL=300
GREENROUTE_SUGGESTION_CACHE_SIZE=256
GREENROUTE_PHOTON_MIN_INTERVAL=0.4
GREENROUTE_PHOTON_TIMEOUT=8

# --- Telemetry --------------------------------------------------------------
# Days of GPS fixes kept in telemetry_fixes. Pruned after every accepted batch.
GREENROUTE_TELEMETRY_RETENTION_DAYS=14
# Metres off the stored route before a recalculation is considered.
GREENROUTE_DEVIATION_M=150
# Minimum seconds between two recalculations for the same response.
GREENROUTE_RECALC_COOLDOWN_S=90
