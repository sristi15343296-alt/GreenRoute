# Copy to .env and point it at whichever host serves the driver API.
#
# Mock server on this laptop, phone on the same Wi-Fi:
#   EXPO_PUBLIC_API_BASE=http://<laptop-lan-ip>:5055
#
# Android device with adb reverse, or iOS simulator:
#   EXPO_PUBLIC_API_BASE=http://127.0.0.1:5055
#
# No trailing slash. Value is inlined at bundle time, so restart `expo start`
# after changing it.
EXPO_PUBLIC_API_BASE=http://127.0.0.1:5055
